# Cloudflare Pages / Worker environment
PUBLIC_SITE_URL=https://crimescenecleanerjobs.com
ADMIN_TOKEN=

# AI parsing and import enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Real job discovery providers
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
DEFAULT_SCAN_LOCATION=Nationwide
JOB_SCAN_QUERIES=crime scene cleanup technician;biohazard remediation technician;trauma scene cleanup jobs;hazmat cleanup technician
AUTO_PUBLISH_JOBS=false
AUTO_PUBLISH_CONFIDENCE=0.92
FETCH_SOURCE_PAGES=false

# Edit code delivery
EDIT_CODE_DAYS=30
EDIT_CODE_PEPPER=
RESEND_API_KEY=
FROM_EMAIL="CrimeSceneCleanerJobs <no-reply@crimescenecleanerjobs.com>"
RETURN_EDIT_CODE_AFTER_EMAIL=false

# Google Indexing API for JobPosting URLs
GOOGLE_INDEXING_ENABLED=false
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
